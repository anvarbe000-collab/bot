# ============ Telegram ============
BOT_TOKEN=bu_yerga_token

# ============ AI (matn yozuvchi miya) ============
# TAVSIYA: Gemini bepul (Google AI Studio) — karta shart emas.
# Kalitni https://aistudio.google.com -> "Get API key" dan olasan.
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_API_KEY=bu_yerga_gemini_kalit
AI_MODEL=gemini-2.5-flash

# --- Muqobil variantlar (kerak bo'lsa AI_* ni almashtir) ---
# Groq (bepul, tez, kartasiz):
#   AI_BASE_URL=https://api.groq.com/openai/v1
#   AI_API_KEY=<groq_kalit>
#   AI_MODEL=llama-3.3-70b-versatile
# Lokal Ollama (GPU, faqat o'z kompyuteringda sinash uchun):
#   AI_BASE_URL=http://localhost:11434/v1
#   AI_API_KEY=ollama
#   AI_MODEL=qwen2.5:7b

# AI rasm (Pollinations — bepul, kalitsiz). O'chirish uchun RASM_YOQ=0
RASM_YOQ=1
IMG_BASE=https://image.pollinations.ai/prompt/
IMG_MODEL=flux
# Rasm provayderi: pollinations (bepul) yoki gemini (Nano banana, PULLIK+karta)
IMG_PROVIDER=pollinations
# IMG_PROVIDER=gemini
# IMG_MODEL_G=gemini-3.1-flash-image-preview
# IMG_KEY=   # bo'sh bo'lsa Gemini matn kaliti ishlatiladi
# Together AI (Flux) uchun (IMG_PROVIDER=together bo'lsa)
IMG_TOGETHER_KEY=
IMG_TOGETHER_MODEL=black-forest-labs/FLUX.2-dev

# ============ Matn tuzatish xizmati (alohida Gemini kalit, ixtiyoriy) ============
# Bo'sh qoldirsang AI_API_KEY/AI_BASE_URL/AI_MODEL ishlatiladi.
# Limitlar aralashmasligi uchun ikkinchi (boshqa) Gemini akkaunt kaliti tavsiya etiladi.
# DIQQAT: YANGI Google akkaunt kaliti bo'lsa, "gemini-2.5-flash" ishlamaydi
# (404: "no longer available to new users") — o'rniga gemini-3.6-flash ishlating.
TUZAT_BASE_URL=
TUZAT_KEY=
TUZAT_MODEL=gemini-3.6-flash

# ============ Til bo'limi (Ingliz yordamchisi + Ilmiy tarjima, ixtiyoriy) ============
# Bo'sh qoldirsang AI_API_KEY/AI_BASE_URL/AI_MODEL ishlatiladi.
TIL_BASE_URL=
TIL_KEY=
TIL_MODEL=gemini-3.6-flash

# ============ Konspekt qilish xizmati (alohida Gemini kalit, ixtiyoriy) ============
# Bo'sh qoldirsang AI_API_KEY/AI_BASE_URL/AI_MODEL ishlatiladi.
KONSPEKT_BASE_URL=
KONSPEKT_KEY=
KONSPEKT_MODEL=gemini-3.6-flash

# ============ "Slayt yaratish" to'lovi (qo'lda tasdiq) ============
# ADMIN_ID — to'lov chekini ko'rib ✅/❌ bosadigan odamning Telegram RAQAM
# ID'si (username EMAS). Olish uchun: Telegramda @userinfobot ga /start bosing,
# u sizga raqamli ID'ingizni yozadi.
ADMIN_ID=
# Bitta taqdimot narxi (so'mda)
TOLOV_SUM=5000

# ============ Click (https://click.uz) — YAGONA to'lov usuli ============
# TO'LDIRILISHI SHART — bo'sh qolsa pullik xizmatlar (Slayt yaratish, Ingliz
# yordamchisi) ISHLAMAYDI. Merchant Cabinet: https://merchant.click.uz
# DIQQAT: bu shunchaki NAMUNA fayl (.env.example) — bu yerga HAQIQIY
# qiymatlarni YOZMANG (git orqali oshkor bo'lishi mumkin). Haqiqiy qiymatlarni
# FAQAT .env fayliga, hech kimga (shu jumladan AI suhbatiga) yubormasdan qo'ying.
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_ID=
CLICK_MERCHANT_USER_ID=
# To'lovdan keyin talaba qaytariladigan sahifa (ixtiyoriy, bo'sh qoldirish mumkin)
CLICK_RETURN_URL=
# Click bizga POST yuboradigan webhook server porti. MUHIM: bu server ORQASIDA
# haqiqiy ochiq HTTPS domen bo'lishi SHART (masalan nginx/Caddy orqali, yoki
# Railway/Render kabi platforma) — Click faqat HTTPS'ga so'rov yubora oladi.
CLICK_WEBHOOK_HOST=0.0.0.0
CLICK_WEBHOOK_PORT=8080
